# ═══════════════════════════════════════════════════════════
# BatteryGuardAI - ما لا يُودَع
#
# نُظِّف من تكرار: كانت dist/ و build/ و .pytest_cache/ و .coverage مكرّرة
# في كتلتين، وهو تكرار يُخفي ما يُقصد فعلاً استثناؤه.
# ═══════════════════════════════════════════════════════════

# ── بايثون ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/

# ── نواتج البناء ──
build/
dist/
build_env/
*.spec.bak
*.exe
*.app
*.dmg

# ── البيئات الافتراضية ──
venv/
env/
ENV/
.venv

# ── المحرّرات وأنظمة التشغيل ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── السجلات ──
*.log
*.log.*

# ── بيانات المستخدم: إعداداته وما تعلّمه التطبيق من جهازه ──
# هذه تُكتب في ~/.config/batteryguard، والاستثناء هنا احتياط لمن يشغّل
# التطبيق من مجلد المشروع مباشرة.
battery_settings.json
battery_ai_data.json
auto_optimizer_settings.json
battery_guard_state.json
*.corrupt

# ── نواتج الاختبارات ──
.pytest_cache/
.qt-test-config/
htmlcov/
.coverage
test_output/

# ── ملفات مؤقتة ──
*.tmp
*.temp
*.bak
*.old

# ── ملفات يُولّدها التشغيل التلقائي على ويندوز ──
run_background.vbs

# ── ذاكرة أدوات خارجية ──
.impeccable/
